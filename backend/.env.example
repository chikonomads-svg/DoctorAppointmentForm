# =============================================================================
# Backend Environment Variables — Dr. Deepak Kumar Prescription System
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp backend/.env.example backend/.env
# =============================================================================

# PostgreSQL connection string (Required)
# Get this from Render Dashboard → PostgreSQL → Internal Database URL
# Or use Neon / Supabase / any PostgreSQL provider
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# OpenAI API Key (Optional — for OCR / AI features)
OPENAI_API_KEY=sk-your-openai-api-key-here

# JWT Secret Key (Optional — for token signing, auto-generated if not set)
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-jwt-secret-key-here